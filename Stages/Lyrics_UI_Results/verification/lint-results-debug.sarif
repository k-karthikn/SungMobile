                                    "startLine": 129,
                                    "endLine": 134,
                                    "snippet": {
                                        "text": "    }\n    companion object {\n        @Volatile private var instance: AppUpdates? = null\n        fun get(context: Context): AppUpdates = instance ?: synchronized(this) {\n            instance ?: AppUpdates(context.applicationContext).also { instance = it }\n"
                                    }
                                }
